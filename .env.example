# Copy to Vercel → Project → Settings → Environment Variables.
# (No local .env is read in production — this file documents what's needed.)

# ── Supabase (Dashboard → Settings → API) ───────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key — SERVER ONLY, never expose to browsers
SUPABASE_SERVICE_KEY=

# ── Admin app origin (CORS for /api/admin/*) ────────────────────────────
ALLOWED_ORIGIN=https://book.korestack.tech

# ── Email (Resend — you already use this for korestack.tech) ────────────
RESEND_API_KEY=
FROM_EMAIL=bookings@korestack.tech

# ── SMS (Twilio — optional; SMS silently disabled when unset) ───────────
# Messaging Service SID is required for scheduled reminder texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── Cron protection (any random string; Vercel sends it automatically) ──
CRON_SECRET=
